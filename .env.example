TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
TELEGRAM_PHONE=+10000000000
TELEGRAM_SESSION_PATH=.telegram/codex
# Safety default: writes are disabled until explicitly enabled.
TELEGRAM_ALLOW_WRITES=false
# Optional: allow writes only to these chat ids (comma-separated). Empty = all chats.
# TELEGRAM_WRITE_CHAT_ALLOWLIST=777000,123456789
# JSONL audit trail for send/edit attempts (ok and denied). Use "off" to disable.
TELEGRAM_AUDIT_LOG_PATH=.telegram/audit.jsonl
