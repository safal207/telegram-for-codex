TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
TELEGRAM_PHONE=+10000000000
# On POSIX, an existing credential directory must already be mode 0700 or stricter.
# The runtime does not chmod a pre-existing parent directory owned by someone else.
TELEGRAM_SESSION_PATH=.telegram/codex
# Safety default: writes are disabled until explicitly enabled.
TELEGRAM_ALLOW_WRITES=false
# Required and non-empty before TELEGRAM_ALLOW_WRITES can be set to true.
# Use integer chat ids only (comma-separated); an empty value never means all chats.
# TELEGRAM_WRITE_CHAT_ALLOWLIST=777000,123456789
# Metadata-only JSONL audit trail for send/edit attempts (ok and denied).
# It contains no Telegram message text and rotates at 10 MiB with 2 backups.
# Use "off" to disable.
TELEGRAM_AUDIT_LOG_PATH=.telegram/audit.jsonl
