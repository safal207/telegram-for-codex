TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
TELEGRAM_PHONE=+10000000000

# Option A — mobile web authorization (no Termux):
# /connect writes the resulting StringSession here. Mount this path on a private
# persistent volume and never serve it as a static file.
TELEGRAM_SESSION_STRING_FILE=/data/telegram/session.string
# Required to use /connect. Generate a long random value and keep it private.
TELEGRAM_CONNECT_TOKEN=replace_with_long_random_connect_key

# Option B — stateless hosting: generate a StringSession elsewhere and inject it
# through the hosting secret manager. If set, it takes precedence over the file.
# TELEGRAM_SESSION_STRING=replace_with_secret_manager_value

# SQLite file session remains supported for local/legacy authorization.
TELEGRAM_SESSION_PATH=/data/telegram/codex
TELEGRAM_ALLOW_WRITES=false
# Optional: restrict writes to explicit chat IDs.
# TELEGRAM_WRITE_CHAT_ALLOWLIST=777000,123456789
# Use "off" on stateless hosts or a persistent path if you need local JSONL audit history.
TELEGRAM_AUDIT_LOG_PATH=/data/telegram/audit.jsonl
TELEGRAM_MCP_HOST=0.0.0.0
PORT=8000
# Required for a public deployment. Include bare host and wildcard-port form.
TELEGRAM_MCP_ALLOWED_HOSTS=telegram.example.com,telegram.example.com:*
# Browser origins permitted to call the MCP endpoint. Adjust to the actual OpenAI surface used in testing.
TELEGRAM_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
