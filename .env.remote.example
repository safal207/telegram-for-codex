TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
TELEGRAM_PHONE=+10000000000

# Phone-first Personal Mode authorization. /connect writes the resulting
# StringSession here; mount this path on a private persistent volume.
TELEGRAM_SESSION_STRING_FILE=/data/telegram/session.string
TELEGRAM_CONNECT_TOKEN=replace_with_long_random_connect_key
# Alternative stateless secret-manager mode:
# TELEGRAM_SESSION_STRING=replace_with_secret_manager_value

TELEGRAM_SESSION_PATH=/data/telegram/codex
TELEGRAM_ALLOW_WRITES=false
# TELEGRAM_WRITE_CHAT_ALLOWLIST=777000,123456789
TELEGRAM_AUDIT_LOG_PATH=/data/telegram/audit.jsonl

TELEGRAM_MCP_HOST=0.0.0.0
PORT=8000
TELEGRAM_MCP_ALLOWED_HOSTS=telegram.example.com,telegram.example.com:*
TELEGRAM_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com

# Remote Personal MCP is fail-closed: there is no unauthenticated mode.
# Production / ChatGPT path: OAuth 2.1 Resource Server + RFC 7662 introspection.
TELEGRAM_MCP_AUTH_MODE=oauth
TELEGRAM_MCP_PUBLIC_URL=https://telegram.example.com/mcp
TELEGRAM_MCP_OAUTH_SCOPES=telegram:personal
TELEGRAM_OAUTH_ISSUER_URL=https://your-auth-provider.example.com/
TELEGRAM_OAUTH_INTROSPECTION_URL=https://your-auth-provider.example.com/oauth2/introspect
TELEGRAM_OAUTH_INTROSPECTION_CLIENT_ID=replace_with_resource_server_client_id
TELEGRAM_OAUTH_INTROSPECTION_CLIENT_SECRET=replace_with_secret_manager_value

# Private smoke-test only (curl/MCP Inspector), NOT the ChatGPT production path:
# TELEGRAM_MCP_AUTH_MODE=static
# TELEGRAM_MCP_PUBLIC_URL=https://telegram.example.com/mcp
# TELEGRAM_MCP_STATIC_TOKEN=replace_with_at_least_32_random_characters
